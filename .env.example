# ============================================================
# PONCHO NEXT — Environment variables (example)
# Copy this file to .env.local and fill in your real values.
# Never commit .env.local to git.
#
# See TODO_HUMAN.md for step-by-step instructions on where to
# create each account / API key.
# ============================================================

# --- Supabase ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site -------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- PayPal -----------------------------------------------------
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# --- Mux (video hosting + signed playback) ----------------------
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# --- OpenAI (Whisper transcription) -----------------------------
OPENAI_API_KEY=

# --- Resend (transactional email) -------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Anto <hello@ponchospanish.com>
RESEND_REPLY_TO=hello@ponchospanish.com

# --- PostHog (product analytics) --------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Sentry (error tracking) ------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=poncho-next

# --- Currency conversion (optional) -----------------------------
EXCHANGE_RATE_API_KEY=

# --- Email (contact form, legacy edge function) -----------------
CONTACT_TO_EMAIL=ponchospanish@gmail.com
